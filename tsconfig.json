{
  "compilerOptions": {
    // 基础配置
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    
    // 严格模式
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    
    // 代码生成
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "importHelpers": true,
    
    // 互操作性
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
    // 路径映射 - 支持monorepo内部包引用
    "baseUrl": ".",
    "paths": {
      "@monitor-sdk/core": ["packages/core/src"],
      "@monitor-sdk/web": ["packages/web/src"],
      "@monitor-sdk/react": ["packages/react/src"],
      "@monitor-sdk/vue": ["packages/vue/src"],
      "@monitor-sdk/miniprogram": ["packages/miniprogram/src"],
      "@monitor-sdk/eslint-config": ["packages/eslint-config"],
      "@monitor-sdk/rollup-config": ["dev/rollup/src"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/types/**/*",
    "dev/*/src/**/*",
    "examples/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/build",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
