{
  "name": "@monitor-sdk/web",
  "version": "1.0.0",
  "description": "Monitor SDK Web平台适配层 - 专为Web浏览器环境设计的监控SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "monitoring",
    "sdk",
    "web",
    "browser",
    "error-tracking",
    "performance",
    "analytics"
  ],
  "author": "Monitor SDK Team",
  "license": "MIT",
  "dependencies": {
    "@monitor-sdk/core": "workspace:*"
  },
  "devDependencies": {
    "@monitor-sdk/eslint-config": "workspace:*",
    "@monitor-sdk/rollup-config": "workspace:*",
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "jsdom": "^24.0.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.6",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "@monitor-sdk/core": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
