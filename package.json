{
  "name": "monorepo-eslint-config",
  "version": "1.0.0",
  "description": "A monorepo with shared ESLint configurations",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . --ext .js,.ts,.tsx --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --ignore-path .gitignore --fix",
    "lint:packages": "pnpm -r lint",
    "lint:packages:fix": "pnpm -r lint:fix",
    "lint:all": "pnpm lint && pnpm lint:packages",
    "lint:all:fix": "pnpm lint:fix && pnpm lint:packages:fix",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "dev": "pnpm -r dev"
  },
  "devDependencies": {
    "@monorepo/eslint-config": "workspace:*",
    "eslint": "^8.45.0",
    "pnpm": "^8.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
